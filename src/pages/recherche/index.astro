---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { emotions, matchesEmotion } from '../../lib/discovery.js';
const seriesCollection = await getCollection('series', ({data}) => data.published && data.status === 'published');
const seriesBySlug = new Map(seriesCollection.map(series=>[series.data.slug,series]));
const photos = (await getCollection('photos', ({data})=>data.status==='published')).map(photo=>{
  const parent = seriesBySlug.get(photo.data.series);
  return {slug:photo.data.slug,title:photo.data.title,series:photo.data.series,
    seriesName:parent?.data.name || '',url:photo.data.url_thumb || photo.data.url,
    tags:[...new Set([...(parent?.data.tags || []),...photo.data.tags])],
    date:photo.data.date?.getTime() || 0,year:photo.data.date?.getUTCFullYear() || '',
    emotions:emotions.filter(emotion=>matchesEmotion(photo,emotion,seriesCollection)).map(emotion=>emotion.slug)};
}).sort((a,b)=>b.date-a.date);
const years = [...new Set(photos.map(photo=>photo.year).filter(Boolean))].sort((a,b)=>Number(b)-Number(a));
const seriesList = seriesCollection.filter(series=>photos.some(photo=>photo.series===series.data.slug)).sort((a,b)=>a.data.name.localeCompare(b.data.name,'fr'));
const tagFreq = new Map<string,number>();
photos.forEach(photo=>photo.tags.forEach(tag=>tagFreq.set(tag,(tagFreq.get(tag)||0)+1)));
const tags = [...tagFreq].sort((a,b)=>a[0].localeCompare(b[0],'fr'));
const popularTags = [...tags].sort((a,b)=>b[1]-a[1]).slice(0,6);
---
<Base title="Recherche | Portfolio" description="Retrouvez une photographie par année, série, ambiance ou mot-clé.">
  <header class="search-intro"><p class="eyebrow">Explorer la galerie</p><h1>Une image en tête,<br /><em>une envie de découverte.</em></h1><p>Un lieu, une année, une ambiance… retrouvez un souvenir ou laissez-vous surprendre.</p></header>
  <form id="search-form" class="search-panel" role="search" aria-label="Rechercher des photographies">
    <label class="search-input-wrap" for="q"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="7.5"/><path d="m16 16 5 5"/></svg><span class="sr-only">Rechercher un titre, un lieu ou un mot-clé</span><input id="q" name="q" type="search" placeholder="Un lieu, un titre, un mot-clé…" autocomplete="off" /></label>
    <div class="filters">
      <div class="filter"><label for="year">Année de prise de vue</label><select id="year" name="year"><option value="">Toutes</option>{years.map(year=><option value={year}>{year}</option>)}</select></div>
      <div class="filter"><label for="series">Série</label><select id="series" name="series"><option value="">Toutes les séries</option>{seriesList.map(series=><option value={series.data.slug}>{series.data.name}</option>)}<option value="__instants">Sans série / Instants</option></select></div>
      <div class="filter"><label for="emotion">Envie de…</label><select id="emotion" name="emotion"><option value="">Au choix</option>{emotions.filter(emotion=>photos.some(photo=>photo.emotions.includes(emotion.slug))).map(emotion=><option value={emotion.slug}>{emotion.name}</option>)}</select></div>
      <div class="filter"><label for="sort">Présenter les images</label><select id="sort" name="sort"><option value="newest">Plus récentes</option><option value="oldest">Plus anciennes</option><option value="title">Titre A → Z</option></select></div>
    </div>
    {tags.length > 0 && <details class="keyword-details"><summary>Affiner par mot-clé <span aria-hidden="true">+</span></summary><div class="keyword-content"><div class="filter"><label for="tag">Choisir un mot-clé</label><select id="tag" name="tag"><option value="">Tous les mots-clés</option>{tags.map(([tag,count])=><option value={tag}>{tag} ({count})</option>)}</select></div><div class="tag-suggestions"><span>Quelques pistes</span>{popularTags.map(([tag])=><button type="button" data-suggested-tag={tag} aria-pressed="false">{tag}</button>)}</div></div></details>}
    <div id="active-filters" class="active-filters" aria-label="Filtres sélectionnés" hidden></div>
    <noscript><p>Activez JavaScript pour combiner les filtres. Toutes les photographies restent accessibles ci-dessous.</p></noscript>
  </form>
  <div class="results-heading"><div><p class="eyebrow">Les photographies</p><p id="result-count" role="status" aria-live="polite" aria-atomic="true">{photos.length} images à découvrir</p></div><button type="button" id="reset" class="reset" hidden>Tout effacer ↺</button></div>
  <section id="results" class="results-grid" aria-label="Photographies trouvées">
    {photos.map(photo=><article class="photo-result" data-slug={photo.slug}>
      <a href={`/photo/${photo.slug}/`} class="photo-link"><div class="image-wrap"><img src={photo.url} alt={photo.title} loading="lazy" decoding="async" /><span class="open-photo" aria-hidden="true">↗</span></div><div class="photo-caption"><h2>{photo.title}</h2><p>{photo.seriesName || 'Instants'}{photo.year && <> <span>·</span> {photo.year}</>}</p></div></a>
    </article>)}
  </section>
  <div id="empty-state" class="empty-state" hidden><span aria-hidden="true">⌕</span><h2>Aucune image sur ce chemin.</h2><p>Essayez une autre année ou retirez un filtre pour élargir la promenade.</p><button type="button" id="empty-reset" class="reset">Revoir toutes les photos →</button></div>
  <div class="load-area" id="load-area" hidden><p id="shown-count"></p><button type="button" id="load-more">Voir plus de photographies ↓</button></div>
  <script type="application/json" id="search-data" set:html={JSON.stringify(photos).replace(/</g, String.fromCharCode(92)+'u003c')} />
</Base>
<style>
.search-intro { margin:2rem 0 2.5rem; max-width:750px; }
.eyebrow { font-family:var(--font-mono); font-size:.65rem; letter-spacing:.16em; text-transform:uppercase; color:var(--accent); margin:0 0 .8rem; }
h1 { font-size:clamp(2.3rem,5vw,4rem); } h1 em { color:var(--accent); }
.search-intro>p:last-child { max-width:58ch; font-size:.95rem; }
.search-panel { padding:clamp(1rem,3vw,2rem); border:1px solid var(--line); background:var(--surface); border-radius:12px; }
.search-input-wrap { display:flex; align-items:center; gap:1rem; border-bottom:1px solid var(--line); padding:0 0 1.2rem; color:var(--accent); }
.search-input-wrap:focus-within { border-color:var(--accent); }
#q { width:100%; min-width:0; color:var(--text); background:none; border:0; padding:.5rem 0; font-size:clamp(1rem,2vw,1.3rem); }
#q::placeholder { color:var(--muted); }
.filters { display:grid; grid-template-columns:.9fr 1.3fr 1fr 1.2fr; gap:1.2rem; margin-top:1.4rem; }
.filter { display:grid; gap:.65rem; min-width:0; align-content:start; }
.filter label { font-size:.75rem; color:var(--muted); }
select { width:100%; min-width:0; padding:.75rem 2rem .75rem .75rem; min-height:46px; color:var(--text); background:var(--bg); border:1px solid var(--line); border-radius:6px; font-size:.85rem; text-overflow:ellipsis; cursor:pointer; }
.keyword-details { margin-top:1.4rem; border-top:1px solid var(--line); }
.keyword-details summary { cursor:pointer; padding:1rem 0 0; font-size:.8rem; color:var(--muted); list-style:none; display:flex; justify-content:space-between; }
.keyword-details summary::-webkit-details-marker { display:none; }
.keyword-details[open] summary span { transform:rotate(45deg); }
.keyword-content { display:grid; grid-template-columns:1fr 2fr; gap:1.5rem; margin-top:1.2rem; }
.tag-suggestions { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
.tag-suggestions>span { width:100%; font-size:.7rem; color:var(--muted); }
button { cursor:pointer; color:var(--text); font:inherit; min-height:44px; }
.tag-suggestions button { padding:.4rem .8rem; border:1px solid var(--line); background:none; border-radius:30px; font-size:.75rem; }
.tag-suggestions button[aria-pressed='true'] { border-color:var(--accent); color:var(--accent); }
.active-filters { display:flex; gap:.5rem; flex-wrap:wrap; padding-top:1.2rem; }
.active-filters :global(button) { border:1px solid var(--accent); border-radius:30px; background:var(--bg); padding:.5rem .8rem; font-size:.75rem; color:var(--accent); }
.results-heading { flex-wrap:wrap; margin:2.5rem 0 1.5rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; }
.results-heading .eyebrow { margin-bottom:.45rem; }
#result-count { margin:0; color:var(--text); font-family:var(--font-display); font-size:1.8rem; }
.reset { background:none; border:0; color:var(--accent); font-size:.8rem; padding:.5rem; }
.results-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:2rem 1.2rem; }
.photo-result { min-width:0; }
.image-wrap { position:relative; overflow:hidden; background:var(--surface); aspect-ratio:4/3; border-radius:3px; }
img { display:block; width:100%; height:100%; object-fit:cover; transition:transform 300ms ease; }
.photo-link:hover img { transform:scale(1.035); }
.open-photo { position:absolute; right:.6rem; bottom:.6rem; padding:.2rem .5rem; background:#191816c9; color:#fff; border-radius:50%; opacity:0; }
.photo-link:hover .open-photo,.photo-link:focus-visible .open-photo { opacity:1; }
.photo-caption { padding:.8rem 0 0; }
.photo-caption h2 { font-family:var(--font-sans); font-size:.85rem; line-height:1.4; overflow-wrap:anywhere; }
.photo-caption p { font-size:.7rem; margin:.3rem 0 0; } .photo-caption p span { padding:0 .25rem; }
.load-area { text-align:center; margin:3rem 0; }
.load-area p { font-size:.8rem; }
#load-more { background:var(--surface); border:1px solid var(--line); padding:.9rem 1.5rem; border-radius:6px; font-size:.85rem; }
.empty-state { text-align:center; margin:4rem auto; max-width:500px; }
.empty-state>span { display:block; font-size:3rem; color:var(--accent); margin-bottom:1rem; }
[hidden] { display:none!important; }
.sr-only { position:absolute; width:1px; height:1px; padding:0; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }
@media(max-width:900px) { .filters { grid-template-columns:repeat(2,minmax(0,1fr)); } .results-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
@media(max-width:600px) { .search-intro { margin:1rem 0 1.5rem; } .search-intro h1 { font-size:2.2rem; } .filters { gap:1rem .75rem; } .keyword-content { grid-template-columns:1fr; } .results-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.5rem .8rem; } .results-heading { align-items:end; } #result-count { font-size:1.5rem; } select { font-size:.78rem; padding-left:.5rem; } }
@media(max-width:400px) { .filters, .results-grid { grid-template-columns:minmax(0,1fr); } }
@media(prefers-reduced-motion:reduce) { img { transition:none; } }
</style>
<script>
import {searchPhotos,normalizeSearch} from '../../lib/photo-search.js';
const data = JSON.parse(document.querySelector('#search-data')?.textContent || '[]');
const form = document.querySelector<HTMLFormElement>('#search-form')!;
const names = ['q','year','series','emotion','tag','sort'];
const controls = Object.fromEntries(names.map(name=>[name,form.elements.namedItem(name)])) as Record<string,HTMLInputElement|HTMLSelectElement|null>;
const cards = new Map([...document.querySelectorAll<HTMLElement>('.photo-result')].map(card=>[card.dataset.slug,card]));
const grid = document.querySelector('#results')!;
const count = document.querySelector('#result-count')!;
const chips = document.querySelector<HTMLElement>('#active-filters')!;
const reset = document.querySelector<HTMLButtonElement>('#reset')!;
const empty = document.querySelector<HTMLElement>('#empty-state')!;
const loadArea = document.querySelector<HTMLElement>('#load-area')!;
const loadMore = document.querySelector<HTMLButtonElement>('#load-more')!;
let limit = 36;
let matches = [];
function readUrl() {
  const params = new URLSearchParams(location.search);
  names.forEach(name=> { const control=controls[name]; if(control) { control.value=params.get(name)||(name==='sort'?'newest':''); if(control instanceof HTMLSelectElement && control.selectedIndex<0) { const option=[...control.options].find(option=>normalizeSearch(option.value)===normalizeSearch(params.get(name))); control.value=option?.value || control.options[0].value; } } });
  if(controls.tag?.value) form.querySelector<HTMLDetailsElement>('details')!.open=true;
}
function run(syncUrl=true) {
  const state = Object.fromEntries(names.map(name=>[name,controls[name]?.value||'']));
  const pool = state.series==='__instants' ? data.filter(photo=>!photo.series) : data;
  const found = searchPhotos(pool,{...state,series:state.series==='__instants'?'':state.series});
  matches=found;
  cards.forEach(card=>card.hidden=true);
  found.slice(0,limit).forEach(photo=>{ const card=cards.get(photo.slug)!; card.hidden=false; grid.appendChild(card); });
  count.textContent=`${found.length} image${found.length>1?'s':''} ${names.some(name=>name!=='sort'&&state[name])?'trouvée'+(found.length>1?'s':''):'à découvrir'}`;
  empty.hidden=found.length>0;
  loadArea.hidden=found.length===0;
  loadMore.hidden=found.length<=limit;
  document.querySelector('#shown-count')!.textContent=`${Math.min(limit,found.length)} sur ${found.length} images`;
  chips.replaceChildren();
  names.filter(name=>name!=='sort'&&state[name]).forEach(name=>{
    const button=document.createElement('button');button.type='button';
    const control=controls[name]!;
    const value=control instanceof HTMLSelectElement ? control.selectedOptions[0].textContent : state[name];
    button.textContent=`${name==='q'?'Recherche : ':''}${value} ×`;
    button.setAttribute('aria-label',`Retirer le filtre ${value}`);
    button.addEventListener('click',()=>{control.value='';limit=36;run();control.focus();});chips.appendChild(button);
  });
  chips.hidden=!chips.childElementCount;
  reset.hidden=chips.hidden&&state.sort==='newest';
  form.querySelectorAll<HTMLButtonElement>('[data-suggested-tag]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.suggestedTag===state.tag)));
  if(syncUrl) { const url=new URL(location.href); names.forEach(name=>{if(state[name]&&!(name==='sort'&&state[name]==='newest'))url.searchParams.set(name,state[name]);else url.searchParams.delete(name);});history.replaceState(null,'',url); }
}
form.addEventListener('submit',event=>event.preventDefault());
form.addEventListener('input',event=>{if(event.target===controls.q){limit=36;run();}});
form.addEventListener('change',()=>{limit=36;run();});
form.querySelectorAll<HTMLButtonElement>('[data-suggested-tag]').forEach(button=>button.addEventListener('click',()=>{if(controls.tag)controls.tag.value=controls.tag.value===button.dataset.suggestedTag?'':button.dataset.suggestedTag!;limit=36;run();}));
function clear(){form.reset();limit=36;run();}
const clearAndFocus = () => { clear(); controls.q?.focus(); };
reset.addEventListener('click',clearAndFocus);document.querySelector('#empty-reset')!.addEventListener('click',clearAndFocus);
loadMore.addEventListener('click',()=>{const previousLimit=limit;limit+=36;run(false);cards.get(matches[previousLimit]?.slug)?.querySelector('a')?.focus({preventScroll:true});});
window.addEventListener('popstate',()=>{limit=36;readUrl();run(false);});
readUrl();run(false);
</script>
