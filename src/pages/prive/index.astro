---
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import PrivatePhotoCard from '../../components/PrivatePhotoCard.astro';
---

<Base title="Galerie privée" description="Accès réservé" noindex>
  <section id="gate" class="gate">
    <div class="gate-card">
      <p class="gate-eyebrow">Galerie privée</p>
      <h1>Vos photos vous attendent</h1>
      <p id="gate-intro">Entrez le code qui accompagne votre lien, et la galerie s’ouvre.</p>

      <form id="gate-form" autocomplete="off">
        <label for="gate-code">Code d’accès</label>
        <input
          id="gate-code"
          name="code"
          type="text"
          inputmode="latin"
          autocapitalize="characters"
          autocomplete="one-time-code"
          spellcheck="false"
          aria-describedby="gate-hint"
          required
        />
        <p id="gate-hint" class="gate-hint">
          Les majuscules, les espaces et les tirets n’ont pas d’importance.
        </p>
        <button type="submit" id="gate-submit">Voir les photos</button>
        <p id="gate-error" class="gate-error" role="alert"></p>
      </form>

      <p class="gate-foot">
        Un doute sur le code ? Répondez simplement au message qui vous a envoyé ce lien.
      </p>
      <p class="gate-visit">
        En attendant, le reste de mon travail se visite sur <a href="https://stan-bouchet.eu/">stan-bouchet.eu</a>.
      </p>
    </div>
  </section>

  <section id="gallery" hidden>
    <header class="gallery-head">
      <h1 id="gallery-title"></h1>
      <p id="gallery-message"></p>

      <div class="gallery-actions">
        <button type="button" id="download-all" hidden>Tout télécharger</button>
        <button type="button" id="download-selection" hidden>Télécharger ma sélection</button>
        <span id="download-state" role="status" aria-live="polite"></span>
      </div>

      <div class="selection-bar" id="selection-bar" hidden>
        <p class="selection-count" id="selection-count" role="status" aria-live="polite"></p>
        <div class="selection-actions">
          <button type="button" id="selection-filter" aria-pressed="false">
            Ne voir que ma sélection
          </button>
          <button type="button" id="selection-validate">Je valide ma sélection</button>
        </div>
        <p class="selection-note" id="selection-note" role="alert"></p>
      </div>
    </header>

    <div class="masonry" id="grid"></div>
    <p id="gallery-empty" hidden>Cette galerie ne contient encore aucune photo.</p>
    <p id="selection-empty" hidden>Aucune photo retenue pour l’instant.</p>

    <aside class="visit-more">
      <h2>Envie de voir autre chose ?</h2>
      <p>
        Ces photos sont les vôtres, mais il y en a bien d’autres : séries, instants,
        carnets de voyage. Tout est sur mon site.
      </p>
      <a class="visit-link" href="https://stan-bouchet.eu/">Visiter la galerie publique</a>
    </aside>
  </section>

  <template id="card-template"><PrivatePhotoCard /></template>

  <Lightbox photos={[]} showDetail={false} downloadable privateTools />
</Base>

<style>
  .gate {
    max-width: 30rem;
    margin: 3rem auto 5rem;
  }

  .gate-card {
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: var(--surface);
    padding: 2.5rem 2rem;
    text-align: center;
    box-shadow: 0 24px 60px -40px rgba(0, 0, 0, 0.9);
  }

  .gate-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--accent-rgb), 0.95);
    margin-bottom: 0.75rem;
  }

  .gate h1 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.1rem);
    line-height: 1.15;
    margin-bottom: 0.6rem;
  }

  #gate-intro {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  .gate form {
    display: grid;
    gap: 0.6rem;
    text-align: left;
  }

  .gate label {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .gate-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: -0.2rem 0 0.4rem;
  }

  .gate-foot {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .gate input {
    width: 100%;
    padding: 0.9rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.25);
    color: inherit;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    letter-spacing: 0.22em;
    text-align: center;
    text-transform: uppercase;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .gate input:focus-visible {
    outline: none;
    border-color: rgba(var(--accent-rgb), 0.7);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.25);
  }

  .gate button {
    padding: 0.75rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--accent-rgb), 0.6);
    background: rgba(var(--accent-rgb), 0.18);
    color: inherit;
    font-size: 0.95rem;
    cursor: pointer;
    min-height: 44px;
  }

  .gate button:hover {
    background: rgba(var(--accent-rgb), 0.3);
  }

  .gate-error:empty {
    display: none;
  }

  .gate-error {
    margin: 0.25rem 0 0;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid rgba(255, 122, 122, 0.35);
    background: rgba(255, 122, 122, 0.1);
    color: #ffb3b3;
    font-size: 0.9rem;
    text-align: left;
  }

  .gallery-head {
    margin-bottom: 2rem;
  }

  .gallery-head h1 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    margin-bottom: 0.35rem;
  }

  .gallery-head > p {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .gallery-head > p:empty {
    display: none;
  }

  .gallery-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .gallery-actions button,
  .selection-actions button {
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--accent-rgb), 0.6);
    background: rgba(var(--accent-rgb), 0.18);
    color: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    min-height: 44px;
  }

  .gallery-actions button:hover,
  .selection-actions button:hover {
    background: rgba(var(--accent-rgb), 0.3);
  }

  .gallery-actions button[disabled],
  .selection-actions button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .selection-actions button[aria-pressed='true'] {
    background: rgba(var(--accent-rgb), 0.45);
  }

  #download-state {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .selection-bar {
    margin-top: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    display: grid;
    gap: 0.75rem;
  }

  .selection-count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .selection-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .selection-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .selection-note:empty {
    display: none;
  }

  .selection-note.is-error {
    color: #ff7a7a;
  }

  .gate-visit {
    margin-top: 0.9rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .gate-visit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .visit-more {
    margin-top: 4rem;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .visit-more h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .visit-more p {
    color: var(--text-muted);
    max-width: 34rem;
    margin: 0 auto 1.25rem;
  }

  .visit-link {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--accent-rgb), 0.6);
    background: rgba(var(--accent-rgb), 0.18);
    color: inherit;
    font-size: 0.95rem;
    text-decoration: none;
    min-height: 44px;
  }

  .visit-link:hover {
    background: rgba(var(--accent-rgb), 0.3);
  }

  .masonry {
    column-count: 1;
    column-gap: 1rem;
  }

  .masonry.only-selection :global(.photo-card:not(.is-kept)) {
    display: none;
  }

  @media (min-width: 720px) {
    .masonry {
      column-count: 2;
    }
  }

  @media (min-width: 1080px) {
    .masonry {
      column-count: 3;
    }
  }
</style>

<script is:inline>
  (function () {
    const params = new URLSearchParams(location.search);
    const slug = (params.get('g') || '').toLowerCase().replace(/[^a-z0-9-]/g, '');

    const gate = document.getElementById('gate');
    const gateForm = document.getElementById('gate-form');
    const gateCode = document.getElementById('gate-code');
    const gateError = document.getElementById('gate-error');
    const gateIntro = document.getElementById('gate-intro');
    const gallery = document.getElementById('gallery');
    const grid = document.getElementById('grid');
    const template = document.getElementById('card-template');
    const titleNode = document.getElementById('gallery-title');
    const messageNode = document.getElementById('gallery-message');
    const emptyNode = document.getElementById('gallery-empty');
    const selectionEmpty = document.getElementById('selection-empty');
    const downloadAll = document.getElementById('download-all');
    const downloadSelection = document.getElementById('download-selection');
    const downloadState = document.getElementById('download-state');
    const selectionBar = document.getElementById('selection-bar');
    const selectionCount = document.getElementById('selection-count');
    const selectionFilter = document.getElementById('selection-filter');
    const selectionValidate = document.getElementById('selection-validate');
    const selectionNote = document.getElementById('selection-note');

    if (!slug) {
      gateIntro.textContent = 'Ce lien est incomplet. Utilisez celui qui vous a été envoyé.';
      gateForm.hidden = true;
      return;
    }

    const api = '/api/galerie/' + encodeURIComponent(slug);
    const imageUrl = (photo, version) =>
      api + '/image?photo=' + encodeURIComponent(photo) + '&version=' + version;

    const state = {
      photos: [],
      settings: null,
      kept: new Set(),
      comments: new Map(),
      ratings: new Map(),
      cards: new Map(),
      validatedAt: null,
    };

    // La visionneuse pilote ses étoiles par cette interface ; sur le site
    // public elle vise le stockage local, ici la galerie du client.
    window.PhotoVotes = {
      getRating: (slug) => state.ratings.get(slug) || 0,
      ratePhoto: (slug, rating) => {
        if (locked()) return;
        const next = state.ratings.get(slug) === rating ? 0 : rating;
        if (next === 0) state.ratings.delete(slug);
        else state.ratings.set(slug, next);
        fetch(api + '/selection', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ photo: slug, rating: next }),
        })
          .then((response) => (response.ok ? response.json() : null))
          .then((data) => {
            if (!data) return;
            state.ratings = new Map((data.ratings || []).map((entry) => [entry.photo, entry.rating]));
          })
          .catch(() => note('Connexion perdue, votre note n’a pas été enregistrée.', true));
      },
    };

    function show(section) {
      gate.hidden = section !== 'gate';
      gallery.hidden = section !== 'gallery';
    }

    function note(message, isError) {
      selectionNote.textContent = message || '';
      selectionNote.classList.toggle('is-error', Boolean(isError));
    }

    function locked() {
      return Boolean(state.validatedAt);
    }

    function refreshSelectionUI() {
      const settings = state.settings;
      if (!settings || !settings.selectionEnabled) return;

      const count = state.kept.size;
      const quota = settings.selectionQuota;
      selectionCount.textContent = quota
        ? count + ' / ' + quota + ' photos retenues'
        : count + ' photo' + (count > 1 ? 's' : '') + ' retenue' + (count > 1 ? 's' : '');

      if (locked()) {
        selectionValidate.hidden = true;
        note('Sélection validée, Stan la reçoit telle quelle. Demandez-lui de la rouvrir si vous changez d’avis.');
      } else {
        selectionValidate.hidden = false;
        selectionValidate.disabled = count === 0;
        if (quota && count > quota && !settings.selectionHard) {
          note('Vous avez dépassé les ' + quota + ' photos prévues : parlez-en avec Stan, il en tiendra compte.');
        }
      }

      if (downloadSelection) {
        downloadSelection.hidden = !settings.downloadable || count === 0;
      }

      state.cards.forEach((card, photoSlug) => {
        const kept = state.kept.has(photoSlug);
        card.classList.toggle('is-kept', kept);
        const button = card.querySelector('[data-card-keep]');
        if (button) {
          button.setAttribute('aria-pressed', kept ? 'true' : 'false');
          button.disabled = locked();
          const label = button.querySelector('[data-card-keep-label]');
          if (label) label.textContent = kept ? 'Gardée' : 'Je la garde';
        }
      });

      if (selectionFilter.getAttribute('aria-pressed') === 'true') {
        selectionEmpty.hidden = count > 0;
      }
      refreshLightboxKeep();
    }

    async function setKept(photoSlug, next) {
      if (locked()) return;
      note('');
      try {
        const response = await fetch(api + '/selection', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ photo: photoSlug, selected: next }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          note(data.error || 'Enregistrement impossible.', true);
          return;
        }
        state.kept = new Set((data.selection || []).map((entry) => entry.photo));
        refreshSelectionUI();
      } catch {
        note('Connexion perdue, votre choix n’a pas été enregistré. Réessayez dans un instant.', true);
      }
    }

    async function saveComment(photoSlug, text) {
      const field = document.getElementById('lb-comment-field');
      const status = document.querySelector('.lb-comment-state');
      if (locked()) return;
      try {
        const response = await fetch(api + '/selection', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ photo: photoSlug, comment: text }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          if (status) status.textContent = data.error || 'Non enregistré';
          return;
        }
        state.comments.set(photoSlug, text);
        state.kept = new Set((data.selection || []).map((entry) => entry.photo));
        if (status) status.textContent = text ? 'Enregistré' : '';
        if (field) field.dataset.saved = text;
        refreshSelectionUI();
      } catch {
        if (status) status.textContent = 'Non enregistré';
      }
    }

    function currentLightboxPhoto() {
      const image = document.querySelector('.lb-image');
      if (!image) return null;
      const match = /[?&]photo=([^&]+)/.exec(image.getAttribute('src') || '');
      return match ? decodeURIComponent(match[1]) : null;
    }

    function refreshLightboxKeep() {
      const keepButton = document.querySelector('.lb-keep');
      const photoSlug = currentLightboxPhoto();
      if (!keepButton || !photoSlug || !state.settings) return;
      const kept = state.kept.has(photoSlug);
      keepButton.setAttribute('aria-pressed', kept ? 'true' : 'false');
      keepButton.textContent = kept ? 'Gardée' : 'Je la garde';
      keepButton.disabled = locked();
    }

    function refreshLightboxComment() {
      const box = document.querySelector('.lb-comment');
      const field = document.getElementById('lb-comment-field');
      const status = document.querySelector('.lb-comment-state');
      const photoSlug = currentLightboxPhoto();
      if (!box || !field || !photoSlug) return;
      const text = state.comments.get(photoSlug) || '';
      field.value = text;
      field.dataset.saved = text;
      field.dataset.photo = photoSlug;
      field.disabled = locked();
      if (status) status.textContent = '';
    }

    function setupLightboxTools() {
      const image = document.querySelector('.lb-image');
      if (!image || image.dataset.toolsBound) return;
      image.dataset.toolsBound = 'true';

      const keepButton = document.querySelector('.lb-keep');
      const downloadLink = document.querySelector('.lb-download');
      const field = document.getElementById('lb-comment-field');

      // La visionneuse ne prévient pas d'un changement d'image : on suit son
      // src, qui porte déjà le nom de la photo affichée.
      const sync = () => {
        const photoSlug = currentLightboxPhoto();
        if (downloadLink && photoSlug) {
          downloadLink.href = api + '/download?photo=' + encodeURIComponent(photoSlug);
        }
        refreshLightboxKeep();
        refreshLightboxComment();
      };
      new MutationObserver(sync).observe(image, { attributes: true, attributeFilter: ['src'] });

      if (keepButton) {
        keepButton.addEventListener('click', () => {
          const photoSlug = currentLightboxPhoto();
          if (photoSlug) setKept(photoSlug, !state.kept.has(photoSlug));
        });
      }

      if (field) {
        field.addEventListener('blur', () => {
          const photoSlug = field.dataset.photo;
          if (photoSlug && field.value !== field.dataset.saved) saveComment(photoSlug, field.value);
        });
      }

      sync();
    }

    function render(data) {
      state.photos = data.photos;
      state.settings = data.gallery;
      state.validatedAt = data.gallery.validatedAt || null;
      state.kept = new Set((data.selection || []).map((entry) => entry.photo));
      state.comments = new Map(
        (data.selection || []).filter((entry) => entry.comment).map((entry) => [entry.photo, entry.comment])
      );
      state.ratings = new Map((data.ratings || []).map((entry) => [entry.photo, entry.rating]));
      state.cards = new Map();

      titleNode.textContent = data.gallery.name;
      messageNode.textContent = data.gallery.message || '';
      document.title = data.gallery.name + ' — Galerie privée';

      grid.replaceChildren();
      data.photos.forEach((photo, index) => {
        const card = template.content.firstElementChild.cloneNode(true);
        const trigger = card.querySelector('[data-card-trigger]');
        const image = card.querySelector('[data-card-image]');
        const title = card.querySelector('[data-card-title]');
        const download = card.querySelector('[data-card-download]');
        const keep = card.querySelector('[data-card-keep]');

        image.src = imageUrl(photo.slug, 'web');
        image.alt = photo.title;
        title.textContent = photo.title;
        trigger.setAttribute('aria-label', 'Ouvrir ' + photo.title + ' en plein écran');
        trigger.dataset.lightboxIndex = String(index);

        if (data.gallery.downloadable) {
          download.href = api + '/download?photo=' + encodeURIComponent(photo.slug);
          download.setAttribute('aria-label', 'Télécharger ' + photo.title);
        } else {
          download.remove();
        }

        if (data.gallery.selectionEnabled) {
          keep.hidden = false;
          keep.setAttribute('aria-label', 'Retenir ' + photo.title);
          keep.addEventListener('click', () => setKept(photo.slug, !state.kept.has(photo.slug)));
        } else {
          keep.remove();
        }

        state.cards.set(photo.slug, card);
        grid.appendChild(card);
      });

      emptyNode.hidden = data.photos.length > 0;
      downloadAll.hidden = !data.gallery.downloadable || data.photos.length === 0;
      selectionBar.hidden = !data.gallery.selectionEnabled;

      if (typeof window.setLightboxPhotos === 'function') {
        window.setLightboxPhotos(
          data.photos.map((photo) => ({
            title: photo.title,
            slug: photo.slug,
            description: photo.description,
            url: imageUrl(photo.slug, 'zoom'),
          }))
        );
      }

      const lightboxDownload = document.querySelector('.lb-download');
      if (lightboxDownload && !data.gallery.downloadable) lightboxDownload.remove();
      const keepButton = document.querySelector('.lb-keep');
      if (keepButton) keepButton.hidden = !data.gallery.selectionEnabled;
      const commentBox = document.querySelector('.lb-comment');
      if (commentBox) commentBox.hidden = !data.gallery.commentsEnabled;
      const stars = document.querySelector('.lb-stars-wrap');
      if (stars) stars.hidden = !data.gallery.selectionEnabled;

      setupLightboxTools();
      if (data.gallery.selectionEnabled) refreshSelectionUI();
      show('gallery');
    }

    async function load() {
      const response = await fetch(api, { credentials: 'same-origin' });
      if (response.status === 401) {
        show('gate');
        return;
      }
      if (!response.ok) {
        gateIntro.textContent = 'Cette galerie n’est pas accessible pour le moment. Revenez un peu plus tard.';
        gateForm.hidden = true;
        show('gate');
        return;
      }
      render(await response.json());
    }

    gateForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      gateError.textContent = '';
      const submit = document.getElementById('gate-submit');
      submit.disabled = true;
      try {
        const response = await fetch(api + '/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ code: gateCode.value }),
        });
        if (!response.ok) {
          const data = await response.json().catch(() => ({}));
          gateError.textContent = data.error || 'Code invalide';
          return;
        }
        gateCode.value = '';
        await load();
      } catch {
        gateError.textContent = 'Connexion impossible. Réessayez dans un instant.';
      } finally {
        submit.disabled = false;
      }
    });

    selectionFilter.addEventListener('click', () => {
      const next = selectionFilter.getAttribute('aria-pressed') !== 'true';
      selectionFilter.setAttribute('aria-pressed', next ? 'true' : 'false');
      selectionFilter.textContent = next ? 'Revoir toutes les photos' : 'Ne voir que ma sélection';
      grid.classList.toggle('only-selection', next);
      selectionEmpty.hidden = !next || state.kept.size > 0;
    });

    selectionValidate.addEventListener('click', async () => {
      if (!confirm('Valider votre sélection ? Vous ne pourrez plus la modifier ensuite.')) return;
      selectionValidate.disabled = true;
      try {
        const response = await fetch(api + '/validate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          note(data.error || 'Validation impossible.', true);
          selectionValidate.disabled = false;
          return;
        }
        state.validatedAt = data.validatedAt;
        refreshSelectionUI();
        refreshLightboxComment();
      } catch {
        note('Connexion perdue. Réessayez dans un instant.', true);
        selectionValidate.disabled = false;
      }
    });

    let polling = null;

    async function prepareArchive(scope) {
      const url = api + '/zip?prepare=1' + (scope ? '&scope=' + scope : '');
      const response = await fetch(url, { credentials: 'same-origin' });
      if (!response.ok) throw new Error('Préparation impossible');
      return response.json();
    }

    function startArchive(button, scope) {
      if (polling) return;
      button.disabled = true;
      downloadState.textContent = 'Préparation de l’archive…';

      const finish = () => {
        button.disabled = false;
        downloadState.textContent = 'Archive prête, le téléchargement démarre.';
        location.href = api + '/zip' + (scope ? '?scope=' + scope : '');
      };

      prepareArchive(scope)
        .then((first) => {
          if (first.status === 'ready') {
            finish();
            return;
          }
          polling = setInterval(async () => {
            try {
              const state = await prepareArchive(scope);
              if (state.status === 'ready') {
                clearInterval(polling);
                polling = null;
                finish();
              } else if (state.status === 'error') {
                clearInterval(polling);
                polling = null;
                button.disabled = false;
                downloadState.textContent = 'La préparation a échoué. Réessayez dans un instant.';
              } else {
                downloadState.textContent =
                  'Préparation de l’archive… ' + state.done + ' / ' + state.total;
              }
            } catch {
              clearInterval(polling);
              polling = null;
              button.disabled = false;
              downloadState.textContent = 'Préparation interrompue.';
            }
          }, 2000);
        })
        .catch(() => {
          button.disabled = false;
          downloadState.textContent = 'Préparation impossible.';
        });
    }

    downloadAll.addEventListener('click', () => startArchive(downloadAll, null));
    downloadSelection.addEventListener('click', () => startArchive(downloadSelection, 'selection'));

    load();
  })();
</script>
