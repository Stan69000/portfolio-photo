---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { resolveSeriesCover } from '../lib/series-cover.js';
import VisitSpotlight from '../components/VisitSpotlight.astro';
import { emotions, matchesEmotion, guidedSelection } from '../lib/discovery.js';

const settingsEntries = await getCollection('settings');
const siteSettings = settingsEntries[0]?.data ?? {};

const heroTitle      = siteSettings.hero_title      || 'Bonjour, moi c\u2019est Stan.';
const aboutText      = siteSettings.about_text      || '';
const aboutLead = siteSettings.about_lead || '';
const aboutSignature = siteSettings.about_signature || '';
const aboutParagraphs = aboutText.split(/\r?\n\s*\r?\n/).map(text => text.trim()).filter(Boolean);
const seriesTitle    = siteSettings.series_title    || 'S\u00e9ries';
const featuredSlug   = siteSettings.featured_photo_slug || '';

const allSeries = await getCollection('series', ({ data }) => data.published);
const allPhotos = (await getCollection('photos')).filter((p) => p.data.status === 'published');

const recentPhotos = allPhotos.filter(photo => photo.data.kind !== 'instant').sort((a, b) => (b.data.published_at?.getTime() ?? b.data.date?.getTime() ?? 0) - (a.data.published_at?.getTime() ?? a.data.date?.getTime() ?? 0)).slice(0, 4);

const instants = allPhotos.filter(p => p.data.kind === 'instant').sort((a,b) => (b.data.published_at?.getTime() ?? 0) - (a.data.published_at?.getTime() ?? 0)).slice(0,3);

const cards = allSeries
  .map((series) => {
    const photos = allPhotos.filter((photo) => photo.data.series === series.data.slug);
    const topTags = (series.data.tags ?? []).slice(0, 3);

    // Large covers use the web image; thumbnails are reserved for small previews.
    const coverUrl = resolveSeriesCover(series.data.cover_url, photos);
    const coverPhoto = photos.find(photo => [photo.data.url, photo.data.url_thumb, photo.data.url_web, photo.data.url_zoom].includes(coverUrl)) || photos[0];
    const coverFallback = coverPhoto?.data.url_web || coverPhoto?.data.url || '';
    const cover = coverUrl && ![coverPhoto?.data.url_thumb].includes(coverUrl) ? coverUrl : coverFallback;

    return {
      slug: series.data.slug,
      name: series.data.name,
      description: series.data.description,
      cover,
      count: photos.length,
      topTags
    };
  })
  .filter((item) => item.count > 0)
  .sort((a, b) => b.count - a.count);
const selectedCards = (siteSettings.featured_series ?? []).map(slug => cards.find(card => card.slug === slug)).filter(Boolean).slice(0, 3);
const homeSeries = [...selectedCards, ...cards.filter(card => !selectedCards.some(selected => selected.slug === card.slug))].slice(0, 3);
const tourCount = guidedSelection(allPhotos, siteSettings.tour_photos).length;
---

<Base title="Portfolio | Accueil" description="L’InStan Photo — Photographe amateur et passionné. Découvrez les photos de Stan Bouchet, entre voyages, rencontres et instants du quotidien.">
  <section class="hero" aria-label="À la une">
    <h1 class="home-title">Des lieux, des rencontres. <em>Des instants à partager.</em></h1>
    <VisitSpotlight photos={allPhotos} series={allSeries} pinned={featuredSlug} revision={siteSettings.discovery_revision} />
  </section>
  {recentPhotos.length > 0 && <section class="recent-photos" aria-labelledby="recent-title">
    <div class="section-heading"><h2 id="recent-title">Dernières photos</h2><a class="text-link" href="/photos/">Toute la galerie →</a></div>
    <div class="recent-grid">{recentPhotos.map(photo => <a href={`/photo/${photo.data.slug}/`}>
      <img src={photo.data.url_thumb || photo.data.url_web || photo.data.url} alt={photo.data.title} loading="lazy" decoding="async" />
      <span>{photo.data.title}</span>
    </a>)}</div>
  </section>}
  {homeSeries.length > 0 && <section id="selection" class="selection">
    <div class="section-heading"><div><p class="kicker">Pour commencer</p><h2>{seriesTitle} à découvrir</h2></div><a class="text-link" href="/series">Toutes les séries →</a></div>
    <div class="selection-grid">{homeSeries.map((card, index) => <a href={`/series/${card.slug}/`} class="selected-card">
      <div class="selected-image"><img src={card.cover} alt={card.name} loading="lazy" decoding="async" /></div>
      <span class="selection-number">0{index + 1} / {card.count} photographies</span><h3>{card.name}</h3><p>{card.description}</p><span class="text-link">Découvrir la série ↗</span>
    </a>)}</div>
  </section>}

  {instants.length > 0 && <section class="instants-preview" aria-labelledby="instants-title">
    <div class="section-heading"><div><p class="kicker">Au fil des jours</p><h2 id="instants-title">Les Instants du quotidien</h2></div><a class="text-link" href="/instants/">Tous les Instants →</a></div>
    <div class="instant-grid">{instants.map(p => <a href={`/photo/${p.data.slug}/`}><img src={p.data.url_thumb || p.data.url} alt={p.data.title} loading="lazy" decoding="async" /><span>{p.data.title}</span></a>)}</div>
  </section>}
  <section class="discovery-doors" aria-labelledby="discovery-title">
    <div>
      <p class="kicker">À votre rythme</p>
      <h2 id="discovery-title">Une autre façon de découvrir</h2>
      {tourCount > 0 && <a class="text-link" href="/visite/">Une première visite en {tourCount} images →</a>}
    </div>
    <div class="emotion-doors" aria-label="Explorer selon votre humeur">{emotions.filter(emotion => allPhotos.some(photo => matchesEmotion(photo, emotion, allSeries))).map(emotion => <a href={`/explorer/${emotion.slug}/`}><span>{emotion.name}</span><span aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="introduction" aria-label="Bienvenue">
    <p class="kicker">Derrière les images</p>
    <div class="introduction-copy">
      <h2>{heroTitle}</h2>
      {aboutLead && <p class="introduction-lead">{aboutLead}</p>}
      {!aboutLead && aboutParagraphs[0] && <p>{aboutParagraphs[0]}</p>}
      {aboutSignature && <p class="introduction-signature">{aboutSignature}</p>}
      <a class="text-link" href="/a-propos">Faire connaissance →</a>
    </div>
  </section>
</Base>

<style>
  .hero { margin-bottom: 2.5rem; }
  .home-title { font-size: clamp(1.4rem, 2.4vw, 2rem); margin: 0 0 1.25rem; }
  .home-title em { font-weight: 300; }
  .kicker { margin: 0 0 .65rem; font-family: var(--font-mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.25rem; }
  .text-link { display: inline-block; padding: .65rem 0; border-bottom: 1px solid var(--line); font-size: .9rem; }
  .recent-photos, .selection, .instants-preview { margin-bottom: 3.5rem; }
  .selection { scroll-margin-top: 8rem; }
  .recent-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .recent-grid img { display: block; width: 100%; height: 160px; object-fit: contain; background: var(--surface); }
  .recent-grid span, .instant-grid span { display: block; margin-top: .65rem; font-size: .8rem; color: var(--muted); }
  .selection-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
  .selected-image { background: var(--surface); }
  .selected-image img { display: block; width: 100%; height: 250px; object-fit: contain; }
  .selection-number { display: block; color: var(--muted); font-family: var(--font-mono); font-size: .7rem; margin: 1rem 0 .65rem; }
  .selected-card h3 { font-size: 1.8rem; }
  .selected-card p { font-size: .9rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .instants-preview { padding: 1.5rem; background: var(--surface); }
  .instant-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .instant-grid img { display: block; width: 100%; height: 160px; object-fit: contain; }
  .discovery-doors { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem; margin: 0 0 3.5rem; padding: 1.5rem 0; border-block: 1px solid var(--line); }
  .discovery-doors h2 { font-size: 1.8rem; }
  .emotion-doors { display: flex; gap: .75rem; flex-wrap: wrap; }
  .emotion-doors a { display: flex; gap: 1rem; align-items: center; min-height: 44px; padding: .65rem 1rem; border: 1px solid var(--line); font-size: .9rem; }
  .emotion-doors a:hover { border-color: var(--accent); }
  .introduction { display: grid; grid-template-columns: minmax(160px, 1fr) minmax(0, 2fr); gap: 2rem; max-width: 920px; margin: 0 auto 2rem; }
  .introduction > .kicker { padding-top: .7rem; }
  .introduction-copy { max-width: 56ch; }
  .introduction-copy h2 { font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; }
  .introduction-lead { font-family: var(--font-display); font-size: 1.5rem; color: var(--text); line-height: 1.4; }
  .introduction-signature { font-family: var(--font-display); font-size: 1.4rem; font-style: italic; color: var(--text); }
  @media (max-width: 700px) {
    .recent-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .recent-grid img { height: 140px; }
    .section-heading { align-items: start; flex-direction: column; gap: .5rem; }
    .selection-grid { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .selected-image img { height: 240px; }
    .instant-grid { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .instant-grid img { height: 200px; }
    .introduction { grid-template-columns: minmax(0, 1fr); gap: 1rem; }
    .introduction > .kicker { padding-top: 0; }
  }
</style>
