---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Lightbox from '../../components/Lightbox.astro';
import Anecdote from '../../components/Anecdote.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import { narrativeChapters } from '../../lib/discovery.js';
import { resolveSeriesCover } from '../../lib/series-cover.js';

export async function getStaticPaths() {
  const seriesEntries = await getCollection('series', ({ data }) => data.published);
  return seriesEntries.map((series) => ({
    params: { slug: series.data.slug },
    props: { series }
  }));
}

const { series } = Astro.props;
const revision = (await getCollection('settings'))[0]?.data.discovery_revision || '0';
const publishedPhotos = (await getCollection('photos')).filter(photo => photo.data.status === 'published');
const photos = publishedPhotos
  .filter((photo) => photo.data.series === series.data.slug && photo.data.status === 'published')
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0))
  .map((photo) => ({
    anecdote: photo.data.anecdote,
    spotlight: photo.data.spotlight,
    diptych_with: photo.data.diptych_with,
    id: photo.id,
    slug: photo.data.slug,
    title: photo.data.title,
    description: photo.data.description,
    url: photo.data.url,
    tags: photo.data.tags ?? []
  }));

const chapters = narrativeChapters(photos);
const sequence = chapters.flat();

const availableSeries = (await getCollection('series')).filter(entry => entry.data.published && entry.data.status === 'published' && entry.data.slug !== series.data.slug);
const curated = series.data.related_series ?? [];
const suggestions = availableSeries.map(entry => {
  const images = publishedPhotos.filter(photo => photo.data.series === entry.data.slug);
  const selected = curated.find(item => item.slug === entry.data.slug);
  const sharedTags = entry.data.tags.filter(tag => series.data.tags.includes(tag)).length;
  return { slug: entry.data.slug, name: entry.data.name, cover: resolveSeriesCover(entry.data.cover_url, images) || images[0]?.data.url_web || images[0]?.data.url,
    count: images.length, invitation: selected?.invitation || (sharedTags ? 'Explorer un univers proche' : 'Découvrir un autre regard'),
    score: selected ? 100 - curated.indexOf(selected) : sharedTags };
}).filter(entry => entry.count > 0 && entry.cover).sort((a, b) => b.score - a.score || a.name.localeCompare(b.name, 'fr')).slice(0, 2);

const allTags = (series.data.tags ?? []).slice(0, 10);
const hero = photos[0];
const mapVisibility = series.data.map_public_visibility ?? 'precise';
const hasSeriesCoords = Number.isFinite(Number(series.data.map_lat)) && Number.isFinite(Number(series.data.map_lng));
const seriesLocationVisible = hasSeriesCoords && mapVisibility !== 'hidden';
const siteBase = Astro.site ?? new URL('https://stan-bouchet.eu');
const canonicalPath = `/series/${series.data.slug}/`;
const pageUrl = new URL(canonicalPath, siteBase).toString();
const pageImage = hero?.url || resolveSeriesCover(series.data.cover_url, photos) || '';

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: series.data.name,
  description: series.data.description,
  url: pageUrl,
  ...(pageImage ? { image: pageImage } : {})
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', siteBase).toString() },
    { '@type': 'ListItem', position: 2, name: 'Séries', item: new URL('/series/', siteBase).toString() },
    { '@type': 'ListItem', position: 3, name: series.data.name, item: pageUrl }
  ]
};

---

<Base
  title={`${series.data.name} | Portfolio`}
  description={series.data.description}
  image={pageImage}
  type="article"
  canonicalPath={canonicalPath}
  jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
>
  <section class="hero album-opening reveal">
    {hero && (
      <button
        type="button"
        class="hero-image"
        data-series-opening={series.data.slug}
        data-revision={revision}
        data-lightbox-index="0"
        aria-label={`Ouvrir ${hero.title} en plein écran`}
      >
        <img src={hero.url} alt={hero.title} loading="eager" decoding="async" />
      </button>
    )}
    <div class="hero-copy">
      <a href="/series" class="back">← Toutes les séries</a>
      <h1>{series.data.name}</h1>
      <p>{series.data.description}</p>
      <div class="series-stats">
        <span>{photos.length} photographie{photos.length > 1 ? 's' : ''}</span>
      </div>
      {allTags.length > 0 && (
        <div class="tags">
          {allTags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </div>
      )}

      {seriesLocationVisible || ((series.data.links ?? []).length > 0) ? (
        <div class="extras-grid">
          {seriesLocationVisible && (
            <div class="map-inline">
              <p class="extras-label">📍 Secteur</p>
              <div id="series-map" class="series-map"></div>
            </div>
          )}
          {(series.data.links ?? []).length > 0 && (
            <div class="links-inline">
              <p class="extras-label">🔗 Liens utiles</p>
              <div class="links-col">
                {(series.data.links ?? []).map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="ext-link">
                    {link.label}
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ) : null}

    </div>
  </section>

  {seriesLocationVisible && (
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script define:vars={{ lat: series.data.map_lat, lng: series.data.map_lng, zoom: series.data.map_zoom ?? 13, name: series.data.map_label || series.data.name }}>
      (function() {
        function initMap() {
          if (!window.L || !document.getElementById('series-map')) return;
          const map = L.map('series-map', { zoomControl: true, scrollWheelZoom: false, attributionControl: true }).setView([lat, lng], zoom);
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            maxZoom: 19,
          }).addTo(map);
          const icon = L.divIcon({
            className: '',
            html: '<div style="width:14px;height:14px;background:#748fff;border:2px solid #fff;border-radius:50%;box-shadow:0 0 8px rgba(116,143,255,.7)"></div>',
            iconSize: [14, 14],
            iconAnchor: [7, 7],
          });
          L.marker([lat, lng], { icon }).addTo(map).bindPopup(`<strong>${name}</strong>`).openPopup();
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initMap);
        } else {
          initMap();
        }
      })();
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  )}

  {hero && <Anecdote text={hero.anecdote} />}
  {sequence.length > 0 && <section id="album" class="album-reading" aria-label={`Photographies de ${series.data.name}`}>
    <div class="reading-heading"><div><p class="story-kicker">Le fil des images</p><h2>Prendre le temps de regarder</h2><p>Chaque image s’ouvre en plein écran.</p></div>
      <div class="reading-switch" role="group" aria-label="Présentation de l’album" hidden>
        <button type="button" data-album-view="story" aria-pressed="true">Au fil des images</button>
        <button type="button" data-album-view="overview" aria-pressed="false">Vue d’ensemble</button>
      </div>
    </div>
    {chapters.map((chapter, chapterIndex) => <section class="album-chapter" aria-label={`Séquence ${chapterIndex + 1}`}>
      {chapters.length > 1 && <div class="chapter-marker"><span>Séquence {String(chapterIndex + 1).padStart(2, '0')}</span><span>Images {chapter[0].index + 1}–{chapter[chapter.length - 1].index + 1}</span></div>}
      <div class="reading-grid">{chapter.map((photo, position) => <figure data-photo-slug={photo.slug} data-pinned={photo.spotlight ? 'true' : undefined} data-paired={photo.paired ? 'true' : undefined} class:list={['reading-photo', { 'reading-wide': !photo.paired && (photo.spotlight || position % 6 === 0), 'reading-pause': !photo.paired && position % 6 === 3, 'reading-pair': photo.paired }]}>
        <button type="button" class="reading-trigger" data-lightbox-index={photo.index} aria-label={`Ouvrir ${photo.title} en plein écran`}>
          <img src={photo.url} alt={photo.title} loading="lazy" decoding="async" style={`view-transition-name: photo-${photo.slug};`} />
          <span class="expand-hint" aria-hidden="true">↗</span>
        </button>
        <figcaption><span class="photo-number">{String(photo.index + 1).padStart(2, '0')}</span><div><span class="reading-title">{photo.title}</span>{photo.description && <p>{photo.description}</p>}</div></figcaption>
        <Anecdote text={photo.anecdote} />
      </figure>)}</div>
    </section>)}
  </section>}

  <section class="continue-exploring" aria-labelledby="continue-title">
    <div class="continue-heading"><div><p class="story-kicker">La découverte continue</p><h2 id="continue-title">Encore un peu de chemin ?</h2></div><a class="all-series-link" href="/series/">Toutes les séries →</a></div>
    <div class="continue-grid">{suggestions.map(item => <a class="continue-card" href={`/series/${item.slug}/`}>
      <div class="continue-image"><img src={item.cover} alt={item.name} loading="lazy" decoding="async" /></div>
      <p class="continue-invitation">{item.invitation} <span aria-hidden="true">↗</span></p><h3>{item.name}</h3><span class="continue-count">{item.count} photographies</span>
    </a>)}</div>
  </section>
  <ReadingProgress selector="[data-series-opening], .reading-photo" total={photos.length} />
  <Lightbox photos={photos} />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
    align-items: stretch;
  }

  .hero-image {
    display: block;
    width: 100%;
    min-height: 300px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    padding: 0;
    background: var(--surface);
    cursor: zoom-in;
    position: relative;
  }

  .hero-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    transition: transform 400ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .hero-image:hover img {
    transform: scale(1.03);
  }

  .hero-copy {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem;
    display: grid;
    align-content: start;
    gap: 0.85rem;
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    transition: color 180ms ease;
  }

  .back:hover {
    color: var(--text);
  }

  .hero-copy h1 {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  }

  .hero-copy p {
    margin: 0;
  }

  .series-stats {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tags span {
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .mosaic {
    columns: 3;
    column-gap: 1rem;
  }

  .tile {
    break-inside: avoid;
    position: relative;
    border-radius: 0.8rem;
    overflow: hidden;
    border: 1px solid var(--line);
    display: block;
    padding: 0;
    background: var(--surface);
    cursor: zoom-in;
    margin-bottom: 1rem;
    width: 100%;
  }

  .tile.large {
    /* intentionnellement identique en masonry — la hauteur naturelle suffit */
  }

  .tile img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tile::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.04) 35%, rgba(0, 0, 0, 0.76) 100%);
    z-index: 1;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .tile:hover::before {
    opacity: 1;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 0.85rem;
    display: grid;
    gap: 0.2rem;
    transform: translateY(6px);
    opacity: 0;
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1), opacity 280ms ease;
  }

  .tile:hover .caption {
    transform: translateY(0);
    opacity: 1;
  }

  .tile:hover img {
    transform: scale(1.04);
  }

  .caption strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 400;
    color: #f5f0e7;
  }

  .caption span {
    font-size: 0.82rem;
    color: rgba(197, 215, 251, 0.9);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-image {
      min-height: 300px;
    }

    .mosaic {
      columns: 2;
    }
  }

  @media (max-width: 520px) {
    .mosaic {
      columns: 1;
    }
  }

  /* ── Extras inline dans hero-copy ── */
  .extras-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  /* Map + Links side by side */
  .extras-grid {
    border-top: 1px solid var(--line);
    padding-top: 0.85rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .map-inline,
  .links-inline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .series-map {
    aspect-ratio: 1;
    width: 100%;
    border-radius: calc(var(--radius) - 4px);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  /* Override Leaflet popup */
  :global(.leaflet-popup-content-wrapper) {
    background: #fff;
    color: #1a2a4a;
    border: 1px solid #d0d8e8;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0,0,0,.18);
  }
  :global(.leaflet-popup-tip) { background: #fff; }
  :global(.leaflet-popup-close-button) { color: var(--accent) !important; }

  /* Links */
  .links-col {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .ext-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text);
    background: rgba(var(--accent-rgb), 0.08);
    border: 1px solid rgba(var(--accent-rgb), 0.25);
    border-radius: 8px;
    padding: 0.45rem 0.8rem;
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
    text-decoration: none;
  }

  .ext-link:hover {
    background: rgba(var(--accent-rgb), 0.18);
    border-color: var(--accent);
    color: var(--accent);
  }

  .ext-link svg {
    opacity: 0.6;
    flex-shrink: 0;
  }
</style>

<style>
  .story-heading { margin: 5rem auto 3rem; max-width: 620px; text-align: center; }
  .story-kicker { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; }
  .story-heading h2, .story-end h2 { font-size: clamp(2rem, 4vw, 3.3rem); }
  .story-heading a, .story-end a { display: inline-block; padding: .8rem 0; border-bottom: 1px solid var(--line); font-size: .9rem; }
  .editorial-mosaic { columns: auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2.5rem); align-items: center; scroll-margin-top: 6rem; }
  .editorial-mosaic .tile { margin: 0; border: 0; border-radius: 2px; }
  .editorial-mosaic .tile:nth-child(7n + 1) { grid-column: 1 / -1; width: 100%; margin: 1.5rem 0; }
  .editorial-mosaic img { max-height: 85svh; object-fit: contain; }
  .story-end { text-align: center; padding: 5rem 1rem; }
  .story-end a { margin: 1rem; }
  .tile:focus-visible, .hero-image:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .tile:focus-visible::before, .tile:focus-visible .caption { opacity: 1; transform: none; }
  @media (hover: none) { .tile::before, .tile .caption { opacity: 1; transform: none; } }
  @media (max-width: 600px) { .editorial-mosaic { grid-template-columns: 1fr; } .editorial-mosaic .tile:nth-child(7n + 1) { margin: .5rem 0; } .story-heading { margin-top: 3rem; } }
  @media (prefers-reduced-motion: reduce) { .tile img, .tile .caption, .hero-image img { transition: none; } }
</style>

<style>
  .continue-exploring { margin-top: clamp(3rem, 8vw, 7rem); padding-top: 2.5rem; border-top: 1px solid var(--line); }
  .continue-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .continue-heading h2 { font-size: clamp(2rem, 4vw, 3.3rem); }
  .all-series-link { padding: .8rem 0; border-bottom: 1px solid var(--line); font-size: .9rem; white-space: nowrap; }
  .continue-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  .continue-image { overflow: hidden; background: var(--surface); }
  .continue-image img { width: 100%; aspect-ratio: 16 / 10; display: block; object-fit: cover; transition: transform 400ms ease; }
  .continue-card:hover img { transform: scale(1.025); }
  .continue-invitation { display: flex; justify-content: space-between; gap: 1rem; color: var(--accent); font-size: .85rem; margin: 1.2rem 0 .5rem; }
  .continue-card h3 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .continue-count { display: block; margin-top: .65rem; color: var(--muted); font-family: var(--font-mono); font-size: .7rem; }
  @media (max-width: 600px) { .continue-grid { grid-template-columns: 1fr; gap: 2.5rem; } .continue-heading { align-items: start; flex-direction: column; gap: 1rem; } }
  @media (prefers-reduced-motion: reduce) { .continue-image img { transition: none; } }
</style>

<style>
  .album-opening { gap: clamp(1.5rem, 4vw, 3rem); margin-bottom: 4rem; align-items: center; }
  .album-opening .hero-image { min-height: 0; border: 0; border-radius: 2px; background: transparent; }
  .album-opening .hero-image img { position: static; width: 100%; height: auto; max-height: 80svh; object-fit: contain; }
  .album-opening .hero-copy { background: none; border: 0; padding: 1rem 0; }
  .album-opening .hero-copy h1 { font-size: clamp(2.2rem, 4vw, 3.8rem); }
  .album-reading { scroll-margin-top: 7rem; }
  .reading-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin: 3rem 0; }
  .reading-heading h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); }
  .reading-heading p:last-child { font-size: .85rem; }
  .reading-switch { display: flex; flex-wrap: wrap; gap: .4rem; }
  .reading-switch[hidden] { display: none; }
  .reading-switch button { border: 1px solid var(--line); border-radius: 2px; background: transparent; color: var(--muted); padding: .65rem .9rem; min-height: 44px; cursor: pointer; font-size: .8rem; }
  .reading-switch button[aria-pressed='true'] { border-color: var(--accent); color: var(--text); }
  .album-chapter + .album-chapter { margin-top: clamp(4rem, 8vw, 7rem); }
  .chapter-marker { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--line); padding: 1rem 0 2rem; color: var(--muted); font-family: var(--font-mono); font-size: .68rem; letter-spacing: .06em; }
  .reading-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 5vw, 4rem) clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .reading-photo { margin: 0; min-width: 0; }
  .reading-wide { grid-column: 1 / -1; }
  .reading-pause { grid-column: 1 / -1; width: 70%; justify-self: center; margin: 1.5rem 0; }
  .reading-trigger { display: block; position: relative; width: 100%; border: 0; padding: 0; background: transparent; cursor: zoom-in; }
  .reading-trigger img { display: block; width: 100%; height: auto; max-height: 80svh; object-fit: contain; }
  .expand-hint { position: absolute; bottom: .65rem; right: .65rem; display: grid; place-items: center; width: 30px; height: 30px; background: rgba(20,19,17,.7); color: #fff; border-radius: 50%; opacity: 0; transition: opacity 180ms ease; }
  .reading-trigger:hover .expand-hint, .reading-trigger:focus-visible .expand-hint { opacity: 1; }
  .reading-photo figcaption { display: flex; align-items: baseline; gap: 1rem; padding-top: .85rem; color: var(--muted); font-size: .82rem; }
  .photo-number { font-family: var(--font-mono); font-size: .65rem; color: var(--accent); flex-shrink: 0; }
  .reading-photo figcaption p { margin: .35rem 0 0; max-width: 65ch; }
  .album-reading[data-view='overview'] .reading-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .album-reading[data-view='overview'] .reading-photo { grid-column: auto; width: 100%; margin: 0; }
  .album-reading[data-view='overview'] .reading-trigger img { max-height: 40svh; }
  @media (max-width: 700px) {
    .reading-heading { align-items: start; flex-direction: column; gap: 1rem; }
    .reading-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .reading-wide, .reading-pause { grid-column: auto; }
    .reading-pause { width: 86%; margin: .75rem 0; }
    .album-reading[data-view='overview'] .reading-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem .75rem; }
    .album-reading[data-view='overview'] figcaption { gap: .4rem; font-size: .75rem; overflow-wrap: anywhere; }
    .album-reading[data-view='overview'] figcaption p { display: none; }
    .expand-hint { opacity: 1; }
  }
</style>
<script>
  import { visitChoice } from '../../lib/visit-choice.js';
  const opening = document.querySelector<HTMLElement>('[data-series-opening]');
  if (opening) {
    // Select a large photograph within each chapter; curated pairs remain together.
    document.querySelectorAll<HTMLElement>('.album-chapter').forEach((chapter, index) => {
      const figures = [...chapter.querySelectorAll<HTMLElement>('[data-photo-slug]')].filter(item => item.dataset.paired !== 'true');
      const pinned = figures.filter(item => item.dataset.pinned === 'true');
      const choice = visitChoice(figures.map(item => ({ slug: item.dataset.photoSlug })), `series:${opening.dataset.seriesOpening}:${opening.dataset.revision}:${index}`);
      figures.forEach(item => item.classList.toggle('reading-wide', pinned.length ? pinned.includes(item) : item.dataset.photoSlug === choice?.slug));
    });
  }
  const album = document.querySelector<HTMLElement>('.album-reading');
  const viewSwitch = album?.querySelector<HTMLElement>('.reading-switch');
  if (album && viewSwitch) {
    viewSwitch.hidden = false;
    viewSwitch.querySelectorAll<HTMLButtonElement>('[data-album-view]').forEach(button => {
      button.addEventListener('click', () => {
        album.dataset.view = button.dataset.albumView;
        viewSwitch.querySelectorAll('[data-album-view]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      });
    });
  }
</script>

<style>
.reading-photo.reading-wide { width: 100%; margin: 1.5rem 0; }
.reading-pair { align-self: center; }
.reading-pair .reading-trigger img { max-height: 65svh; }
@media(max-width:700px) { .reading-photo.reading-wide { margin: .75rem 0; } }
</style>
