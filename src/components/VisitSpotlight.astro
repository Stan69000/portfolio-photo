---
const { photos, series = [], pinned = '', revision = '0' } = Astro.props;
const candidates = photos.map(photo => ({
  slug: photo.data.slug,
  title: photo.data.title,
  url: photo.data.url_web || photo.data.url,
  series: series.some(item => item.data.slug === photo.data.series) ? photo.data.series : ''
}));
const initial = candidates.find(photo => photo.slug === pinned) || candidates[0];
const isPinned = candidates.some(photo => photo.slug === pinned);
---
{initial && <div class="visit-spotlight" data-visit-spotlight data-pinned={pinned} data-revision={revision}>
  <a class="spotlight-image" href={`/photo/${initial.slug}/`} data-photo-link aria-label={`Voir la photo : ${initial.title}`}>
    <img src={initial.url} alt={initial.title} loading="eager" fetchpriority="high" decoding="async" />
  </a>
  <div class="spotlight-copy">
    <p class="spotlight-kicker" data-spotlight-kicker>{isPinned ? 'À la une · choisie par Stan' : 'Au hasard de la galerie'}</p>
    <h2 data-spotlight-title>{initial.title}</h2>
    <p>Un regard, une rencontre, un instant. Laissez-vous surprendre par une image de la galerie.</p>
    <a class="spotlight-link" href={initial.series ? `/series/${initial.series}/` : `/photo/${initial.slug}/`} data-series-link>{initial.series ? 'Découvrir cette série →' : 'Découvrir cette photo →'}</a>
    {candidates.length > 1 && <button type="button" data-shuffle hidden>Une autre photo <span aria-hidden="true">↻</span></button>}
  </div>
  <script type="application/json" data-spotlight-candidates set:html={JSON.stringify(candidates).replace(/</g, '\u003c')} />
</div>}
<script>
  import { visitChoice } from '../lib/visit-choice.js';
  type Candidate = { slug: string; title: string; url: string; series: string };
  document.querySelectorAll<HTMLElement>('[data-visit-spotlight]').forEach(root => {
    const candidates: Candidate[] = JSON.parse(root.querySelector('[data-spotlight-candidates]')?.textContent || '[]');
    const key = `home:${root.dataset.revision}`;
    let chosen = candidates.find(photo => photo.slug === root.dataset.pinned) || visitChoice(candidates, key);
    const render = (photo: Candidate) => {
      const link = root.querySelector<HTMLAnchorElement>('[data-photo-link]');
      if (link) { link.href = `/photo/${photo.slug}/`; link.setAttribute('aria-label', `Voir la photo : ${photo.title}`); }
      const img = root.querySelector('img');
      if (img) { img.src = photo.url; img.alt = photo.title; }
      const title = root.querySelector('[data-spotlight-title]');
      if (title) title.textContent = photo.title;
      const seriesLink = root.querySelector<HTMLAnchorElement>('[data-series-link]');
      if (seriesLink) {
        seriesLink.href = photo.series ? `/series/${photo.series}/` : `/photo/${photo.slug}/`;
        seriesLink.textContent = photo.series ? 'Découvrir cette série →' : 'Découvrir cette photo →';
      }
    };
    if (chosen) render(chosen);
    const button = root.querySelector<HTMLButtonElement>('[data-shuffle]');
    if (button) {
      button.hidden = false;
      button.addEventListener('click', () => {
        const alternatives = candidates.filter(photo => photo.slug !== chosen?.slug);
        chosen = alternatives[Math.floor(Math.random() * alternatives.length)];
        if (!chosen) return;
        try { sessionStorage.setItem(`gallery:${key}`, chosen.slug); } catch { /* Storage is optional. */ }
        render(chosen);
        const kicker = root.querySelector('[data-spotlight-kicker]');
        if (kicker) kicker.textContent = 'Au hasard de la galerie';
      });
    }
  });
</script>
<style>
.visit-spotlight { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); min-width: 0; background: var(--surface); border: 1px solid var(--line); }
.spotlight-image { display: flex; align-items: center; justify-content: center; min-width: 0; height: clamp(300px, 34vw, 420px); background: var(--bg); }
img { width: 100%; height: 100%; object-fit: contain; display: block; }
.spotlight-copy { display: flex; flex-direction: column; justify-content: center; align-items: start; padding: clamp(1.25rem, 3vw, 2.5rem); }
.spotlight-kicker { margin: 0 0 1rem; text-transform: uppercase; font-size: .65rem; letter-spacing: .15em; color: var(--accent); }
h2 { font-size: clamp(1.6rem, 2.5vw, 2.4rem); overflow-wrap: anywhere; }
.spotlight-copy > p:not(.spotlight-kicker) { font-size: .9rem; margin: 1rem 0; }
.spotlight-link { padding: .65rem 0; border-bottom: 1px solid var(--accent); font-size: .9rem; }
button { margin-top: 1rem; min-height: 44px; padding: .5rem 0; background: none; border: 0; color: var(--muted); cursor: pointer; font-size: .85rem; }
button span { margin-left: .5rem; }
button:hover { color: var(--text); }
@media (max-width: 700px) {
  .visit-spotlight { grid-template-columns: minmax(0, 1fr); }
  .spotlight-image { height: 280px; }
  .spotlight-copy { padding: 1.25rem; }
  .spotlight-copy > p:not(.spotlight-kicker) { display: none; }
  .spotlight-kicker { margin-bottom: .65rem; }
}
</style>
